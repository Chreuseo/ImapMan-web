# URL and shared secret of the ImapMan backend (never use NEXT_PUBLIC_ here).
IMAPMAN_API_URL=http://imapman:8080
IMAPMAN_API_SECRET=replace-with-a-long-random-secret

# none: authentication is handled by the intranet/reverse proxy
# basic: browser HTTP Basic authentication
# oidc: Keycloak/OpenID Connect Authorization Code flow
FRONTEND_AUTH_MODE=none
FRONTEND_SESSION_SECRET=replace-with-a-random-32-byte-secret
FRONTEND_BASIC_AUTH_USERNAME=admin
FRONTEND_BASIC_AUTH_PASSWORD=change-me
OIDC_ISSUER_URL=https://keycloak.example.org/realms/imapman
OIDC_CLIENT_ID=imapman-web
OIDC_CLIENT_SECRET=
# Optional: realm or client role required for access. Leave empty to permit all authenticated users.
OIDC_REQUIRED_ROLE=imapman-admin
